{
  "name": "claimclarity-intelligence",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "test:module1": "node --loader ts-node/esm apps/web/tests/module1.test.ts",
    "test:module2": "node --loader ts-node/esm/transpile-only --experimental-specifier-resolution=node apps/web/tests/module2.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint && pnpm typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.22.0",
    "eslint-plugin-import": "^2.31.0",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "simple-git-hooks": "^2.11.1",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1"
  },
  "dependencies": {
    "p-limit": "^6.2.0",
    "zod": "^3.24.2"
  }
}
